{
  "name": "fuo-attendance-staff",
  "version": "5.1.0",
  "private": true,
  "description": "ATTENDANCE (FEG-TECH 5.1) staff app for Federal University Otuoke, packaged as an Android APK with Capacitor",
  "scripts": {
    "vendor": "node scripts/fetch-vendor.mjs",
    "android:add": "cap add android && node scripts/patch-android.mjs",
    "sync": "cap sync android && node scripts/patch-android.mjs",
    "apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
